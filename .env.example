# ==============================================================================
# KarigarAI Environment Variables Template
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# Supabase Public Configuration (Exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Configuration (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API Key (Server-Only, used in Next.js Server Actions / API Routes)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# Application Base URL (Used for absolute URLs, social sharing previews, QR codes)
# In local development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment Mode
NODE_ENV=development
